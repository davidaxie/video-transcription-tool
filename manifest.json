{
  "manifest_version": 3,
  "name": "Transcript Grabber",
  "version": "1.1.0",
  "description": "Pull the transcript from any YouTube video, read it cleanly, copy it, download it, or send it straight to Claude for a detailed summary.",
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Transcript Grabber"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
